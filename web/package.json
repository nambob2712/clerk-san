{
  "name": "clerksan-local-review-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.12.0 <27",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "generate:i18n": "node scripts/generate-i18n.mjs",
    "contract:check": "node scripts/verify-openapi.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "build": "npm run generate:i18n && npm run typecheck && vite build"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.1.21",
    "@tabler/icons-react": "3.46.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
