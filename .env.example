# Clerk-san runtime configuration template.
#
# Uncomment only values that need to override the checked-in defaults in
# clerksan/config.py.
#
# Docker Compose requires POSTGRES_PASSWORD. Set it in your shell before running
# docker compose, and never commit passwords or credentials:
#   export POSTGRES_PASSWORD='choose-a-long-local-password'
# POSTGRES_DB=clerksan
# POSTGRES_USER=clerksan

# Database, storage, and local service endpoints.
# CLERKSAN_DATABASE_URL=postgresql+asyncpg://clerksan@db:5432/clerksan
# CLERKSAN_DATABASE_PASSWORD=<your-local-postgres-password>
# CLERKSAN_OLLAMA_URL=http://ollama:11434
# CLERKSAN_STORAGE_DIR=/data/doc_store
# CLERKSAN_API_URL=http://127.0.0.1:8000
# CLERKSAN_UI_STATIC_DIR=web/dist
# Comma-separated exact loopback origins. Keep the Vite origin only for local development.
# CLERKSAN_BROWSER_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:5173

# Static intake mode. Keep legacy unless the isolated parser profile is running
# and the universal activation checks pass for both API and worker.
# CLERKSAN_INTAKE_MODE=legacy             # legacy | universal
# CLERKSAN_PARSER_REQUEST_TIMEOUT_SECONDS=20

# Local OCR, extraction, routing, and pinned retrieval model.
# CLERKSAN_OCR_ENGINE=vision_llm            # vision_llm | yomitoku | paddleocr
# CLERKSAN_OCR_MODEL=gemma3:4b
# CLERKSAN_EXTRACT_MODEL=qwen2.5:7b
# CLERKSAN_ROUTER_MODEL=qwen2.5:7b
# CLERKSAN_EMBED_MODEL=nomic-embed-text:v1.5
# CLERKSAN_EMBED_MODEL_DIGEST=0a109f422b47e3a30ba2b10eca18548e944e8a23073ee3f3e947efcf3c45e59f
# CLERKSAN_EMBED_DIM=768
# CLERKSAN_EMBEDDING_BATCH_SIZE=16

# Review and worker behavior.
# CLERKSAN_CONFIDENCE_THRESHOLD=0.85
# CLERKSAN_WORKER_CONCURRENCY=1
# CLERKSAN_JOB_LEASE_SECONDS=120
# CLERKSAN_JOB_MAX_ATTEMPTS=4
# CLERKSAN_JOB_RETRY_BASE_SECONDS=2

# Intake limits.
# CLERKSAN_MAX_UPLOAD_BYTES=26214400
# Maximum time to receive the next request-body chunk before parsing; default 10 seconds.
# CLERKSAN_REQUEST_RECEIVE_TIMEOUT_SECONDS=10
# CLERKSAN_MAX_PDF_PAGES=100
# CLERKSAN_MAX_IMAGE_PIXELS=40000000
# CLERKSAN_MAX_IMAGE_WIDTH=12000
# CLERKSAN_MAX_IMAGE_HEIGHT=12000
# CLERKSAN_MAX_ARCHIVE_MEMBERS=2000
# CLERKSAN_MAX_ARCHIVE_UNCOMPRESSED_BYTES=209715200
# CLERKSAN_MAX_ARCHIVE_EXPANSION_RATIO=100.0
# CLERKSAN_PDF_MIN_CHARS_PER_PAGE=32
# CLERKSAN_PDF_MOJIBAKE_RATIO=0.30

# Reporting and local-development switches.
# CLERKSAN_REMINDER_DAYS_AHEAD=7
# CLERKSAN_ANOMALY_THRESHOLD=0.5
# CLERKSAN_DEMO_MODE=false
# CLERKSAN_SQL_ECHO=false
